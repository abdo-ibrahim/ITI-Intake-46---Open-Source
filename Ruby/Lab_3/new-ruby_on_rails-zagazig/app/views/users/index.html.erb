<h1>Users</h1>

<%= link_to "New User", new_user_path %>

<% if @users.any? %>
  <table border="1" cellpadding="5">
    <thead>
      <tr>
        <th>Name</th>
        <th>DOB</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= link_to user.name, user %></td>
          <td><%= user.dob %></td>
          <td><%= user.email %></td>
          <td><%= user.phone_number %></td>
          <td><%= user.address %></td>
          <td>
            <%= link_to "Edit", edit_user_path(user) %> |
            <%= link_to "Delete", user, method: :delete, data: { confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No users yet.</p>
<% end %>
